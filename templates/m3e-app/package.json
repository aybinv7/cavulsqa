{
  "name": "@cavulsqa/template-m3e-app",
  "version": "0.0.0",
  "private": true,
  "description": "Vue 3 + Capacitor + SQLite starter in Material 3 Expressive: Framework7 as the navigation engine only, @cavulsqa/m3e-vue components, 2025-spec dynamic colour with a colour studio, light and dark.",
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "type-check": "vue-tsc --noEmit",
    "test": "vp test",
    "check": "vp check"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "catalog:",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/keyboard": "^8.0.0",
    "@capacitor/preferences": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0",
    "@cavulsqa/m3e": "workspace:*",
    "@cavulsqa/m3e-vue": "workspace:*",
    "@cavulsqa/mobile-db": "workspace:*",
    "@cavulsqa/reactive-db": "workspace:*",
    "@cavulsqa/reactive-vue": "workspace:*",
    "@fontsource-variable/google-sans-flex": "^5.3.1",
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@vueuse/core": "catalog:",
    "framework7": "^9.0.2",
    "framework7-vue": "catalog:",
    "kysely": "catalog:",
    "tailwindcss": "catalog:",
    "vue": "^3.5.0",
    "vue-i18n": "^11.2.2",
    "wa-sqlite": "catalog:"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@iconify-json/material-symbols": "1.2.93",
    "@intlify/unplugin-vue-i18n": "catalog:",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.3",
    "happy-dom": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-icons": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-tsc": "^3.2.4"
  },
  "cavulsqa": {
    "storageEngines": [
      "sqlite-wasm-opfs-sahpool",
      "wa-sqlite-access-handle-pool",
      "wa-sqlite-opfs-async",
      "wa-sqlite-idb-batch-atomic",
      "capacitor-sqlite"
    ],
    "engineModules": {
      "opfsSahPool": {
        "file": "src/shared/database/candidates/opfsSahPool.ts",
        "engines": [
          "sqlite-wasm-opfs-sahpool"
        ],
        "exports": [
          "opfsSahPool"
        ],
        "dependencies": [
          "@sqlite.org/sqlite-wasm"
        ]
      },
      "waSqlite": {
        "file": "src/shared/database/candidates/waSqlite.ts",
        "engines": [
          "wa-sqlite-access-handle-pool",
          "wa-sqlite-opfs-async",
          "wa-sqlite-idb-batch-atomic"
        ],
        "exports": [
          "waAccessHandlePool",
          "waOriginPrivateFileSystem",
          "waIdbBatchAtomic"
        ],
        "dependencies": [
          "wa-sqlite"
        ]
      },
      "capacitorSqlite": {
        "file": "src/shared/database/candidates/capacitorSqlite.ts",
        "engines": [
          "capacitor-sqlite"
        ],
        "exports": [
          "capacitorSqlite"
        ],
        "dependencies": [
          "@capacitor-community/sqlite"
        ]
      }
    }
  }
}
