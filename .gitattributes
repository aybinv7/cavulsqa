# Normalise line endings so Windows and CI agree on file hashes.
#
# Without this, core.autocrlf=true rewrites every checked-out file to CRLF while
# the index keeps LF. Git then warns on every add, and any tool that compares
# bytes - a formatter, a checksum, a bundle build - sees a difference that is not
# in the history.
* text=auto eol=lf

# Scripts that break if they ever gain CRLF.
*.sh text eol=lf

# Windows-only entry points, which break the other way.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.ttf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.sqlite binary
*.db binary

# Lockfiles: keep diffs out of review noise.
pnpm-lock.yaml linguist-generated=true -diff
