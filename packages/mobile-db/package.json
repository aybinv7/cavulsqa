{
  "name": "@cavulsqa/mobile-db",
  "version": "1.1.0",
  "description": "SQLite for Kysely on a phone: WebAssembly in a worker against a real OPFS file, or the native Capacitor plugin, with migrations, transaction-aware writes and column helpers.",
  "keywords": [
    "capacitor",
    "kysely",
    "offline-first",
    "sqlite"
  ],
  "homepage": "https://github.com/aybinv7/cavulsqa/tree/main/packages/mobile-db#readme",
  "bugs": {
    "url": "https://github.com/aybinv7/cavulsqa/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/cavulsqa.git",
    "directory": "packages/mobile-db"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./capacitor": "./dist/capacitor.mjs",
    "./opfs": "./dist/opfs.mjs",
    "./testing": "./dist/testing.mjs",
    "./wa": "./dist/wa.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@sqlite.org/sqlite-wasm": "catalog:",
    "@types/node": "catalog:",
    "bumpp": "^11.1.0",
    "kysely": "catalog:",
    "sql.js": "1.13.0",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wa-sqlite": "catalog:"
  },
  "peerDependencies": {
    "@capacitor-community/sqlite": ">=7",
    "@capacitor/core": ">=8",
    "@sqlite.org/sqlite-wasm": ">=3.50",
    "capacitor-sqlite-kysely": ">=1",
    "kysely": "^0.29",
    "sql.js": ">=1.13",
    "wa-sqlite": ">=1"
  },
  "peerDependenciesMeta": {
    "@capacitor-community/sqlite": {
      "optional": true
    },
    "@capacitor/core": {
      "optional": true
    },
    "@sqlite.org/sqlite-wasm": {
      "optional": true
    },
    "capacitor-sqlite-kysely": {
      "optional": true
    },
    "sql.js": {
      "optional": true
    },
    "wa-sqlite": {
      "optional": true
    }
  }
}
