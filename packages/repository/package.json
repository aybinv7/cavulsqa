{
  "name": "@cavulsqa/repository",
  "version": "1.2.0",
  "description": "Local-first data access for Kysely: a per-table repository over a stable row identity, with soft deletes and reactive writes.",
  "keywords": [
    "kysely",
    "local-first",
    "offline-first",
    "repository",
    "sqlite"
  ],
  "homepage": "https://github.com/aybinv7/cavulsqa/tree/main/packages/repository#readme",
  "bugs": {
    "url": "https://github.com/aybinv7/cavulsqa/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/cavulsqa.git",
    "directory": "packages/repository"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@cavulsqa/mobile-db": "workspace:*",
    "@types/node": "catalog:",
    "bumpp": "^11.1.0",
    "kysely": "catalog:",
    "sql.js": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "kysely": ">=0.28"
  },
  "peerDependenciesMeta": {
    "kysely": {
      "optional": true
    }
  }
}
