{
  "name": "@cavulsqa/create",
  "version": "2.10.0",
  "description": "Create a Vue + Capacitor + SQLite app from the cavulsqa templates: Framework7 (iOS and Material) or Material 3 Expressive.",
  "keywords": [
    "capacitor",
    "create",
    "framework7",
    "material-3",
    "material-expressive",
    "scaffold",
    "sqlite",
    "template",
    "vue"
  ],
  "homepage": "https://github.com/aybinv7/cavulsqa/tree/main/packages/create#readme",
  "bugs": {
    "url": "https://github.com/aybinv7/cavulsqa/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aybinv7/cavulsqa.git",
    "directory": "packages/create"
  },
  "bin": {
    "create-cavulsqa": "./bin/create.mjs"
  },
  "files": [
    "bin",
    "lib",
    "templates"
  ],
  "type": "module",
  "exports": {
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/bundleTemplates.mjs",
    "check": "vp check",
    "test": "vp test",
    "prepack": "node scripts/bundleTemplates.mjs",
    "stamp": "node scripts/stampTemplates.mjs"
  },
  "devDependencies": {
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "createConfig": {
    "templates": [
      {
        "name": "f7-app",
        "description": "Vue 3 + Framework7 + Capacitor + SQLite, tabbed shell, iOS and Material themes, offline-first data layer",
        "template": "./templates/f7-app",
        "default": true
      },
      {
        "name": "m3e-app",
        "description": "Material 3 Expressive: m3e-vue components, 2025 dynamic colour with a colour studio, adaptive bar/rail shell, offline-first data layer",
        "template": "./templates/m3e-app"
      }
    ]
  },
  "templatesFingerprint": "sha256-WkAmXqgYKsDG4RCf5Q2l4L3dXkuJgKYP5F9eHV0RwwE="
}
